#!/usr/bin/env bash
# claude-agent: run always-on Claude Code Remote Control agents on a Linux host, one tmux session each.
#
#   claude-agent start <name>      start the agent's tmux session (used by claude-agent@<name>.service)
#   claude-agent stop <name>       stop it (<agent>-t-<id>: end that task session, see below)
#   claude-agent run <name>        (inside tmux) exec claude with the agent's settings
#   claude-agent say <name> <msg>  type a prompt into the running session (routines, handoffs)
#   claude-agent peek <name>       print the visible screen of the session
#   claude-agent deliver           deliver queued handoffs from /var/lib/claude-agents/handoffs/inbox
#   claude-agent list              show agents and whether they're running
#   claude-agent task <agent> [--repo <path>] [--model <m>[:effort]] [--name <title>] [--fix] [--dry-run] "<prompt>"
#                                  start a NEW Remote Control session for one task (see below)
#   claude-agent tasks [<agent>]   list running task sessions (FIX column: Y for the fix session)
#   claude-agent resume <agent>-t-<id> "<title>" [model] [--fix]
#                                  restart a dead task session, continuing its conversation
#   claude-agent stop <agent>-t-<id> [--keep-worktree]
#                                  end a task session (kill-session on that exact session; removes
#                                  its worktree if clean, keeps the branch)
#
# Task sessions: a standing "master" agent dispatches one session per task so each task's context
# lives in its own session. `task` runs as the agent's RUN_AS user with the agent's permission mode,
# settings file, secrets and ENV_VARS (same code as `run`), in its own tmux server (socket
# claude-<agent>-t-<id>, session <agent>-t-<id>) so restarting the master never kills tasks. The
# session is `claude --remote-control "<RC_NAME> · <title>"` with the prompt (plus a short preamble)
# as its initial prompt. With a repo (--repo, or TASK_REPO) it starts in a fresh git worktree on
# branch task/<id>-<slug>, which also groups it under that repo in the Claude app; otherwise it
# starts in /var/lib/claude-agents/<agent>. peek/say work on <agent>-t-<id> too. Root or the agent's own user
# can run task/tasks/stop for that agent (no sudo needed for an agent to start its own tasks).
#
# Fix sessions (`task --fix`): the "fix agent" for a failed e2e run on main (started by a CI watcher).
# Title is prefixed "Fix:", the tmux session is marked @task_fix=1, it is exempt from TASK_MAX, and
# it is refused while another fix session of that agent is running (one at a time). `resume` keeps
# the flag (a title starting "Fix:" or --fix).
# Who may run e2e is decided by which --settings file a session gets, two root-owned files:
#   /etc/claude-agents/<name>.settings.json       base deny rules; used by FIX sessions
#   /etc/claude-agents/<name>.task-settings.json  base denies plus the e2e denies; used by the standing
#                                                 master and normal task sessions (when the file exists;
#                                                 agents without one use <name>.settings.json for all)
# A master picks the change up on its next restart; running sessions keep what they started with.
#
# Optional task vars in the env file: TASK_MODEL (default sonnet), TASK_REPO, TASK_WORKTREES
# (default /var/lib/claude-agents/<name>/worktrees).
#
# Each agent has a root-owned config /etc/claude-agents/<name>.env (root sources it, so it must
# never live in a folder the agent's user can write):
#   RC_NAME (name shown in the Claude app), RUN_AS (user), optional MODEL,
#   ADD_DIRS (space-separated), PERMISSION_MODE (default bypassPermissions),
#   ENV_VARS (space-separated KEY=VALUE exported into the session, e.g. ENABLE_CLAUDEAI_MCP_SERVERS=false)
#   TASK_MODEL, TASK_REPO, TASK_WORKTREES, TASK_MAX (task sessions, above; TASK_MAX 0 = unlimited)
# plus optional /etc/claude-agents/<name>.settings.json (deny rules, MCP approvals), passed with
# --settings so the agent can't edit them,
# and a working folder /var/lib/claude-agents/<name>/ owned by RUN_AS with:
#   secrets.env   optional, mode 600, sourced into the session environment as RUN_AS (never committed)
#   CLAUDE.md, .mcp.json, .claude/settings.json  the agent's instructions, tools and deny rules
set -euo pipefail

AGENTS_DIR=/var/lib/claude-agents
CONF_DIR=/etc/claude-agents
HANDOFF_DIR=$AGENTS_DIR/handoffs

die() { echo "claude-agent: $*" >&2; exit 1; }

# ev_log <event> <agent> <task-id> <kind task|fix> <title>: append one TSV line (epoch, event, agent,
# task, kind, title) to $EVENT_LOG for the agent-metrics exporter. Events: task_start, fix_start,
# resume, stop. Best effort: a write failure (or a missing log dir) never affects the command.
EVENT_LOG=${CLAUDE_AGENT_EVENT_LOG:-/var/log/claude-agent/events.log}
ev_log() {
  { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$1" "$2" "$3" "$4" "$(printf '%s' "$5" | tr '\t\n\r' '   ')" >> "$EVENT_LOG"; } 2>/dev/null || true
}


SELF=/usr/local/bin/claude-agent

# load <agent | agent-t-id>: read the agent's config. For a task session name, NAME is still the
# agent; TASK_ID is set and SESSION/SOCK point at the task's own tmux server.
load() {
  NAME=${1:?agent name required}
  [[ $NAME =~ ^[a-z0-9-]+$ ]] || die "bad agent name: $NAME"
  TASK_ID=""
  if [[ ! -f $CONF_DIR/$NAME.env && $NAME =~ ^([a-z0-9-]+)-t-([0-9a-f]{6})$ ]]; then
    TASK_ID=${BASH_REMATCH[2]}; NAME=${BASH_REMATCH[1]}
  fi
  DIR=$AGENTS_DIR/$NAME
  [[ -f $CONF_DIR/$NAME.env ]] || die "no $CONF_DIR/$NAME.env"
  RC_NAME=$NAME RUN_AS=root MODEL="" ADD_DIRS="" PERMISSION_MODE=bypassPermissions ENV_VARS=""
  TASK_MODEL=sonnet TASK_REPO="" TASK_WORKTREES="" TASK_MAX=0
  # shellcheck source=/dev/null
  source "$CONF_DIR/$NAME.env"
  if [[ -n $TASK_ID ]]; then SESSION=$NAME-t-$TASK_ID; else SESSION=$NAME; fi
  SOCK=claude-$SESSION
}

# trust_dir <dir>: mark <dir> trusted in the agent user's ~/.claude.json so a new session there
# doesn't stop on the "trust this folder" or "allow external CLAUDE.md imports" prompts. Trust covers subfolders, so trusting the worktrees
# folder covers every task worktree. No-op when already trusted; atomic rewrite.
trust_dir() {
  as_user python3 - "$1" <<'PY' || echo "warning: could not pre-trust $1" >&2
import json, os, sys
d = sys.argv[1]
f = os.path.expanduser("~/.claude.json")
try:
    cfg = json.load(open(f))
except FileNotFoundError:
    cfg = {}
proj = cfg.setdefault("projects", {}).setdefault(d, {})
want = {"hasTrustDialogAccepted": True, "hasClaudeMdExternalIncludesApproved": True,
        "hasClaudeMdExternalIncludesWarningShown": True}
if any(not proj.get(k) for k in want):
    proj.update(want)
    tmp = f"{f}.tmp.{os.getpid()}"
    with open(tmp, "w") as fh:
        json.dump(cfg, fh, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, f)
PY
}

# answer_startup_prompts: for ~60s after a task starts, accept the "allow external CLAUDE.md imports"
# prompt if it shows anyway. trust_dir pre-approves it, but a root agent shares root's ~/.claude.json
# with every running root session, and one of those can rewrite the file and drop the new entry.
# Runs in the background; only ever answers that exact prompt.
answer_startup_prompts() {
  local i
  for i in $(seq 30); do
    sleep 2
    running || return 0
    if tmx capture-pane -p -t "=$SESSION:" 2>/dev/null | grep -q 'Allow external CLAUDE.md file imports?'; then
      tmx send-keys -t "=$SESSION:" Down Enter
      return 0
    fi
  done
}

# Run a command as the agent's user: via runuser from root, directly if we already are that user.
as_user() {
  if [[ $(id -un) == "$RUN_AS" ]]; then "$@"
  elif [[ $EUID -eq 0 ]]; then runuser -u "$RUN_AS" -- "$@"
  else die "must run as root or $RUN_AS for agent $NAME"
  fi
}

# TMUX is unset so this also works when called from inside an agent's own tmux session.
tmx() { as_user env -u TMUX tmux -L "$SOCK" "$@"; }

# "=" makes tmux match the session name exactly, never as a prefix (web vs web-t-ab12cd).
running() { tmx has-session -t "=$SESSION" 2>/dev/null; }

# Session environment shared by `run` and `task-run`: HOME/USER, secrets.env, ENV_VARS.
# Call as the agent's user, inside tmux.
session_env() {
  # systemd doesn't set HOME/USER for system services.
  HOME=$(getent passwd "$(id -un)" | cut -d: -f6); USER=$(id -un)
  export HOME USER SHELL=/bin/bash
  if [[ -f $DIR/secrets.env ]]; then
    set -a
    # shellcheck source=/dev/null
    source "$DIR/secrets.env"
    set +a
  fi
  export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1 AGENT_NAME=$NAME
  local kv
  for kv in $ENV_VARS; do export "${kv?}"; done
}

# Settings file for a session: fix sessions ($FIX=1) get <name>.settings.json, everything else gets
# <name>.task-settings.json when it exists (it adds the e2e denies), else <name>.settings.json.
FIX=0
# Every session also gets $CONF_DIR/global.settings.json (root-owned denies for all agents: rm -rf
# on home/system paths, rm -rf over ssh, force-push to main, ...). The agent file and the global
# file are merged into a root-owned file under /run/claude-agents, which is what --settings gets.
settings_file() {
  local f=$CONF_DIR/$NAME.settings.json g=$CONF_DIR/global.settings.json
  if [[ $FIX -ne 1 && -f $CONF_DIR/$NAME.task-settings.json ]]; then f=$CONF_DIR/$NAME.task-settings.json; fi
  if [[ ! -f $g ]]; then [[ -f $f ]] && printf '%s' "$f"; return 0; fi
  local out=/run/claude-agents/$NAME-$FIX.settings.json
  if [[ ! -f $out || $g -nt $out || ( -f $f && $f -nt $out ) ]]; then
    if [[ $EUID -eq 0 ]]; then
      mkdir -p /run/claude-agents && chmod 755 /run/claude-agents
      python3 - "$g" "${f:-}" "$out" <<'PY'
import json, os, sys
g, f, out = sys.argv[1:]
merged = json.load(open(g))
if f and os.path.exists(f):
    a = json.load(open(f))
    for k, v in a.items():
        if k == "permissions":
            p = merged.setdefault("permissions", {})
            for pk, pv in v.items():
                p[pk] = (p.get(pk, []) + [x for x in pv if x not in p.get(pk, [])]) if isinstance(pv, list) else pv
        else:
            merged[k] = v
tmp = out + ".tmp"
json.dump(merged, open(tmp, "w"), indent=2); os.chmod(tmp, 0o644); os.replace(tmp, out)
PY
    elif [[ ! -f $out ]]; then
      # Not root (an agent starting its own task) and no merged file yet: fall back to the agent file.
      [[ -f $f ]] && printf '%s' "$f"; return 0
    fi
  fi
  printf '%s' "$out"
  return 0
}

# Fill ARGS with the claude flags shared by `run` and `task-run`: permission mode, model
# ($1, may be empty), the root-owned settings file (see settings_file) and ADD_DIRS.
base_args() {
  ARGS=()
  if [[ $PERMISSION_MODE == bypassPermissions ]]; then
    ARGS+=(--dangerously-skip-permissions)
  else
    ARGS+=(--permission-mode "$PERMISSION_MODE")
  fi
  # model may carry an effort level: "opus:high" -> --model opus --effort high
  local m=${1:-} e=""
  [[ $m == *:* ]] && { e=${m#*:}; m=${m%%:*}; }
  [[ -n $m ]] && ARGS+=(--model "$m")
  [[ -n $e ]] && ARGS+=(--effort "$e")
  local sf; sf=$(settings_file)
  [[ -n $sf ]] && ARGS+=(--settings "$sf")
  local d
  for d in $ADD_DIRS; do ARGS+=(--add-dir "$d"); done
  # Task sessions start in a worktree: let them read the agent's own folder (CLAUDE.md, plans,
  # notes) without a permission prompt.
  [[ $PWD != "$DIR" ]] && ARGS+=(--add-dir "$DIR")
  return 0
}

# Start a task's tmux server in its own systemd scope, so restarting the master agent's unit
# (claude-agent@<name>.service, whose cgroup the master runs in) doesn't kill its task sessions.
tmx_task_new() {
  local uid; uid=$(id -u "$RUN_AS")
  if [[ $EUID -eq 0 && $RUN_AS != root && -S /run/user/$uid/bus ]]; then
    # via the user's own systemd so the session keeps its supplementary groups (e.g. agents,
    # needed to write the handoff inbox); systemd-run --uid would drop them
    runuser -u "$RUN_AS" -- env XDG_RUNTIME_DIR="/run/user/$uid" \
      systemd-run --user --scope --quiet --collect -- tmux -L "$SOCK" "$@"
  elif [[ $EUID -eq 0 ]]; then
    systemd-run --scope --quiet --collect -- tmux -L "$SOCK" "$@"
  elif [[ -S /run/user/$uid/bus ]]; then
    XDG_RUNTIME_DIR=/run/user/$uid systemd-run --user --scope --quiet --collect -- tmux -L "$SOCK" "$@"
  else
    echo "claude-agent: no user systemd (enable linger for $RUN_AS); task will die with the master" >&2
    tmux -L "$SOCK" "$@"
  fi
}

# TASK_MAX (env file, 0 = no limit; fix sessions don't count): refuse to start or resume a task session when that many of the
# agent's tasks are already running. Enforced here, not left to the agent's instructions.
check_task_max() {
  [[ ${TASK_MAX:-0} -gt 0 ]] || return 0
  local n=0 id sess=$SESSION sock=$SOCK
  for id in $(task_ids); do
    SESSION=$NAME-t-$id; SOCK=claude-$SESSION
    # a fix session is exempt from the cap and doesn't use up a normal task's slot
    if running && ! is_fix_session "$SESSION"; then n=$((n + 1)); fi
  done
  SESSION=$sess; SOCK=$sock
  (( n < TASK_MAX )) || die "$NAME already has $n of $TASK_MAX task sessions running; stop or finish one first (claude-agent tasks $NAME)"
}

# Is the task session $1 (full name) a fix session? Reads the tmux marker; call with $NAME/$RUN_AS set.
is_fix_session() {
  local sess=$SESSION sock=$SOCK v
  SESSION=$1; SOCK=claude-$1
  v=$(tmx show-options -v -t "=$SESSION:" @task_fix 2>/dev/null || true)
  SESSION=$sess; SOCK=$sock
  [[ $v == 1 ]]
}

# Refuse when a fix session of this agent is already running (only one at a time).
check_no_fix() {
  local id sess=$SESSION sock=$SOCK found=""
  for id in $(task_ids); do
    SESSION=$NAME-t-$id; SOCK=claude-$SESSION
    if running && is_fix_session "$SESSION"; then found=$SESSION; break; fi
  done
  SESSION=$sess; SOCK=$sock
  [[ -z $found ]] || die "a fix session for $NAME is already running ($found); only one at a time"
}

cmd_start() {
  load "$1"
  [[ -z $TASK_ID ]] || die "$SESSION is a task session; start tasks with: claude-agent task $NAME ..."
  running && { echo "$NAME already running"; return 0; }
  tmx new-session -d -s "$NAME" -x 200 -y 50 -c "$DIR" "$SELF run $NAME"
  tmx set-option -t "=$NAME:" history-limit 20000 >/dev/null
}

cmd_stop() {
  load "$1"
  if [[ -n $TASK_ID ]]; then stop_task "${2:-}"; return; fi
  tmx kill-server 2>/dev/null || true
}

cmd_run() {
  load "$1"
  [[ -z $TASK_ID ]] || die "run is for standing agents"
  session_env
  cd "$DIR"
  base_args "$MODEL"
  local args=(--remote-control "$RC_NAME" "${ARGS[@]}")
  # Resume the previous conversation after a restart, if there is one.
  local proj="$HOME/.claude/projects/${DIR//\//-}"
  if compgen -G "$proj/*.jsonl" >/dev/null; then args+=(--continue); fi
  exec "$HOME/.local/bin/claude" "${args[@]}"
}

cmd_say() {
  load "$1"; shift
  local msg="$*"
  [[ -n $msg ]] || die "nothing to say"
  running || die "$SESSION is not running"
  # One line only: the Claude Code prompt submits on Enter.
  msg=${msg//$'\n'/ }
  tmx send-keys -t "=$SESSION:" -l -- "$msg"
  sleep 0.5
  tmx send-keys -t "=$SESSION:" Enter
}

cmd_peek() {
  load "$1"
  tmx capture-pane -p -t "=$SESSION:"
}

cmd_deliver() {
  shopt -s nullglob
  local f base from to
  for f in "$HANDOFF_DIR"/inbox/*.md; do
    base=$(basename "$f")
    # Root runs this on files agents wrote: only plain files, never symlinks.
    if [[ -L $f || ! -f $f ]]; then rm -f "$f"; continue; fi
    # <timestamp>__<from>__<to>__<kind>.md, written by agent-handoff
    IFS=_ read -r _ _ from _ to _ kind <<<"${base%.md}"
    if ! ( load "$to" && running ); then
      echo "handoff $base: agent '$to' not running, leaving it queued" >&2
      continue
    fi
    mv "$f" "$HANDOFF_DIR/delivered/$base"
    chmod 640 "$HANDOFF_DIR/delivered/$base"
    if [[ $kind == result ]]; then
      cmd_say "$to" "Result from the $from agent for a job you handed over: read $HANDOFF_DIR/delivered/$base. Do not reply to it with agent-handoff; tell the owner if it matters."
    elif [[ ! -f $CONF_DIR/$from.env && $from != owner ]]; then
      cmd_say "$to" "Alert from $from (an automated watcher, not an agent): read $HANDOFF_DIR/delivered/$base and handle it as your CLAUDE.md says. Don't reply with agent-handoff; tell the owner only if they need to know or act."
    elif [[ $from == owner ]]; then
      cmd_say "$to" "Job from the owner: read $HANDOFF_DIR/delivered/$base and do what it asks."
    else
      cmd_say "$to" "Handoff from the $from agent: read $HANDOFF_DIR/delivered/$base and do what it asks. When finished, report back once with: agent-handoff --result $from \"<short result>\""
    fi
  done
}

cmd_list() {
  local d n
  for d in "$CONF_DIR"/*.env; do
    n=$(basename "$d" .env)
    ( load "$n"; printf '%-12s %-18s %-10s %s\n' "$n" "$RC_NAME" "$RUN_AS" "$(running && echo running || echo stopped)" )
  done
}

# ---- task sessions -------------------------------------------------------------------------

short_id() { od -An -N3 -tx1 /dev/urandom | tr -d ' \n'; }

slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-30)
  s=${s%-}
  printf '%s' "${s:-task}"
}

# Print a command (first word is a raw label), quoted so it can be pasted into a shell.
show() { printf '  %s ' "$1"; shift; printf '%q ' "$@"; printf '\n'; }

cmd_task() {
  local agent=${1:-}; shift || true
  [[ -n $agent ]] || die 'usage: claude-agent task <agent> [--repo <path>] [--model <m>] [--name <title>] [--fix] [--dry-run] "<prompt>"'
  local repo="" model="" title="" dry=0 prompt="" fix=0
  while (($#)); do
    case $1 in
      --repo) repo=${2:?--repo needs a path}; shift 2 ;;
      --model) model=${2:?--model needs a value}; shift 2 ;;
      --name) title=${2:?--name needs a title}; shift 2 ;;
      --fix) fix=1; shift ;;
      --dry-run) dry=1; shift ;;
      --) shift; prompt=$*; break ;;
      -*) die "unknown option: $1" ;;
      *) prompt=$*; break ;;
    esac
  done
  [[ -n $prompt ]] || prompt=$(cat)
  [[ -n $prompt ]] || die "empty task prompt"
  load "$agent"
  [[ -z $TASK_ID ]] || die "give the agent name, not a task session: $agent"
  [[ -d $DIR ]] || die "no $DIR"
  [[ -n $model ]] || model=$TASK_MODEL
  [[ $model =~ ^[A-Za-z0-9] && $model != *[[:space:]]* ]] || die "bad model: $model"
  [[ -n $repo ]] || repo=$TASK_REPO

  if [[ -z $title ]]; then
    title=$(printf '%s' "$prompt" | head -n1 | tr -s '[:space:]' ' ' | cut -d' ' -f1-6)
  fi
  if ((fix)) && [[ $title != Fix:* ]]; then title="Fix: $title"; fi
  title=$(printf '%s' "$title" | tr -d '[:cntrl:]' | cut -c1-40)
  [[ -n $title ]] || title=task
  FIX=$fix

  local id slug
  id=$(short_id); slug=$(slugify "$title")
  # Reuse the session name check so an id can never collide with a live task.
  SESSION=$NAME-t-$id; SOCK=claude-$SESSION
  local rcname="$RC_NAME · $title"

  local workdir=$DIR branch="" base="" wt="" repo_abs=""
  if [[ -n $repo ]]; then
    repo_abs=$(as_user realpath -e -- "$repo" 2>/dev/null) || die "repo not found (as $RUN_AS): $repo"
    as_user git -C "$repo_abs" rev-parse --git-dir >/dev/null 2>&1 \
      || die "not a git repo (as $RUN_AS): $repo_abs"
    branch=task/$id-$slug
    wt=${TASK_WORKTREES:-$DIR/worktrees}/$SESSION
    base=$(as_user git -C "$repo_abs" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || echo HEAD)
    workdir=$wt
  fi

  # Preamble + prompt, written to a private file that task-run reads and deletes.
  local pre="You are a task session for the $NAME agent ($RC_NAME), started with claude-agent task."
  if [[ -n $branch ]]; then
    pre+=" You are in $workdir, a git worktree of $repo_abs on branch $branch: keep all work on this branch, open a PR with gh pr create, and never push to main."
  else
    pre+=" You are in $workdir. If you change a repo, work on a branch and open a PR; never push to main."
  fi
  if ((fix)); then
    pre+=" You are the FIX session: the only session allowed to run the end-to-end suite, because it failed on main. Only one fix session runs at a time."
  else
    pre+=" You must not run the end-to-end suite (it is denied for task sessions): use unit tests; e2e runs on every merge to main and a fix session handles failures."
  fi
  pre+=" Temp folders: create with t=\$(mktemp -d) and remove that exact variable (rm -rf \"\$t\"); never rm -rf a path you did not create, and never rm -rf \$OLDPWD, ~, \$HOME or anything on another machine."
  pre+=" Standing rules for this agent are in $DIR/CLAUDE.md. Do only the task below. When it is done, report once with: agent-handoff --result $NAME \"<short result, PR link if any>\" and then stop and wait. If you are blocked, ask the owner here rather than guessing."
  local full="$pre"$'\n\n'"Task:"$'\n'"$prompt"

  if ((dry)); then
    echo "DRY RUN (nothing created). agent=$NAME run_as=$RUN_AS session=$SESSION socket=$SOCK"
    echo "RC name: $rcname   model: $model   permission-mode: $PERMISSION_MODE   fix: $fix (settings: $(settings_file || true))"
    if ((fix)) && ( check_no_fix ) 2>/dev/null; then :; elif ((fix)); then echo "NOTE: a real run would be refused: a fix session is already running"; fi
    if [[ -n $repo_abs ]]; then
      echo "worktree: $wt (branch $branch from $base of $repo_abs)"
      show "[as $RUN_AS]" git -C "$repo_abs" fetch -q origin
      show "[as $RUN_AS]" git -C "$repo_abs" worktree add -b "$branch" "$wt" "$base"
    else
      echo "worktree: none, cwd $workdir"
    fi
    echo "tmux:"
    show "[as $RUN_AS]" tmux -L "$SOCK" new-session -d -s "$SESSION" -x 200 -y 50 -c "$workdir" "$SELF" task-run "$SESSION" "$title" "$model" "<promptfile>" "$fix"
    base_args "$model"
    echo "claude (in $workdir, after session_env: HOME, secrets.env, ENV_VARS=$(printf '%s' "$ENV_VARS" | sed -E 's/=[^ ]*/=.../g')):"
    show "\$HOME/.local/bin/claude" --remote-control "$rcname" "${ARGS[@]}" -- "<prompt>"
    echo "prompt (${#full} chars):"; printf '%s\n' "$full" | sed 's/^/  | /'
    return 0
  fi

  running && die "session $SESSION already exists, retry"
  if ((fix)); then check_no_fix; else check_task_max; fi
  if [[ -n $repo_abs ]]; then
    as_user mkdir -p "$(dirname "$wt")"
    as_user timeout 30 git -C "$repo_abs" fetch -q origin 2>/dev/null || true
    as_user git -C "$repo_abs" worktree add -q -b "$branch" "$wt" "$base" || die "worktree add failed"
  fi
  [[ -n $repo_abs ]] && trust_dir "$(dirname "$wt")"
  trust_dir "$workdir"
  local pf
  pf=$(as_user mktemp /tmp/claude-task.XXXXXX)
  printf '%s\n' "$full" | as_user tee "$pf" >/dev/null
  if ! tmx_task_new new-session -d -s "$SESSION" -x 200 -y 50 -c "$workdir" "$SELF" task-run "$SESSION" "$title" "$model" "$pf" "$fix"; then
    as_user rm -f "$pf"; die "tmux new-session failed"
  fi
  tmx set-option -t "=$SESSION:" history-limit 20000 >/dev/null
  tmx set-option -t "=$SESSION:" @task_title "$title" >/dev/null
  tmx set-option -t "=$SESSION:" @task_model "$model" >/dev/null
  ((fix)) && tmx set-option -t "=$SESSION:" @task_fix 1 >/dev/null
  tmx set-option -t "=$SESSION:" @task_branch "$branch" >/dev/null
  tmx set-option -t "=$SESSION:" @task_dir "$workdir" >/dev/null
  tmx set-option -t "=$SESSION:" @task_repo "$repo_abs" >/dev/null
  ev_log "$( ((fix)) && echo fix_start || echo task_start )" "$NAME" "$id" "$( ((fix)) && echo fix || echo task )" "$title"
  (answer_startup_prompts </dev/null >/dev/null 2>&1 &)
  echo "started $SESSION ($rcname, $model) in $workdir${branch:+ on $branch}"
}

# Inside tmux: exec claude for a task. $1 session, $2 title, $3 model, $4 prompt file (or --continue),
# $5 fix flag (1 = fix session: gets the base settings file, without the e2e denies).
cmd_task_run() {
  load "$1"
  [[ -n $TASK_ID ]] || die "task-run needs a task session name"
  local title=$2 model=$3 pf=$4 prompt
  FIX=${5:-0}
  if [[ $pf == --continue ]]; then
    session_env
    base_args "$model"
    exec "$HOME/.local/bin/claude" --remote-control "$RC_NAME · $title" "${ARGS[@]}" --continue
  fi
  [[ -f $pf ]] || die "no prompt file $pf"
  prompt=$(cat "$pf"); rm -f "$pf"
  session_env
  base_args "$model"
  exec "$HOME/.local/bin/claude" --remote-control "$RC_NAME · $title" "${ARGS[@]}" -- "$prompt"
}

# claude-agent resume <agent>-t-<id> "<title>" [model]: restart a dead task session in its worktree,
# continuing its previous conversation (e.g. after a reboot).
cmd_resume() {
  load "$1"
  [[ -n $TASK_ID ]] || die "resume needs a task session name (<agent>-t-<id>)"
  shift
  local pos=() fix=0 a
  for a in "$@"; do if [[ $a == --fix ]]; then fix=1; else pos+=("$a"); fi; done
  local title=${pos[0]:?title required} model=${pos[1]:-$TASK_MODEL} wt
  [[ $title == Fix:* ]] && fix=1
  FIX=$fix
  wt=${TASK_WORKTREES:-$DIR/worktrees}/$SESSION
  [[ -d $wt ]] || wt=$DIR
  running && die "$SESSION is already running"
  if ((fix)); then check_no_fix; else check_task_max; fi
  as_user rm -f "/tmp/tmux-$(id -u "$RUN_AS")/$SOCK"
  tmx_task_new new-session -d -s "$SESSION" -x 200 -y 50 -c "$wt" "$SELF" task-run "$SESSION" "$title" "$model" --continue "$fix"
  tmx set-option -t "=$SESSION:" history-limit 20000 >/dev/null
  tmx set-option -t "=$SESSION:" @task_title "$title" >/dev/null
  tmx set-option -t "=$SESSION:" @task_model "$model" >/dev/null
  ((fix)) && tmx set-option -t "=$SESSION:" @task_fix 1 >/dev/null
  tmx set-option -t "=$SESSION:" @task_branch "$(as_user git -C "$wt" branch --show-current 2>/dev/null)" >/dev/null
  ev_log resume "$NAME" "$TASK_ID" "$( ((fix)) && echo fix || echo task )" "$title"
  echo "resumed $SESSION ($RC_NAME · $title) in $wt"
}

# Echo the task ids that have a tmux socket for the current $NAME/$RUN_AS.
task_ids() {
  local dir f id uid
  uid=$(id -u "$RUN_AS")
  dir=/tmp/tmux-$uid
  for f in "$dir"/claude-"$NAME"-t-*; do
    [[ -S $f ]] || continue
    id=${f##*-t-}
    [[ $id =~ ^[0-9a-f]{6}$ ]] && echo "$id"
  done
  return 0
}

print_tasks() {
  local id fmt
  fmt='#{session_name}|#{session_created}|#{@task_model}|#{@task_fix}|#{@task_branch}|#{@task_title}'
  for id in $(task_ids); do
    SESSION=$NAME-t-$id; SOCK=claude-$SESSION
    tmx list-sessions -F "$fmt" 2>/dev/null | while IFS='|' read -r sn created m fx b t; do
      printf '%-22s %-8s %-9s %-4s %-34s %s\n' "$sn" "$(age "$created")" "$m" "$([[ $fx == 1 ]] && echo Y || echo -)" "${b:--}" "$t"
    done || true  # stale socket of a stopped task: skip it rather than abort the listing
  done
}

age() {
  local d=$(( $(date +%s) - $1 ))
  if (( d >= 86400 )); then echo "$((d / 86400))d"; elif (( d >= 3600 )); then echo "$((d / 3600))h"; else echo "$((d / 60))m"; fi
}

cmd_tasks() {
  local n
  printf '%-22s %-8s %-9s %-4s %-34s %s\n' SESSION AGE MODEL FIX BRANCH TITLE
  if [[ -n ${1:-} ]]; then ( load "$1"; print_tasks ); return; fi
  for d in "$CONF_DIR"/*.env; do
    n=$(basename "$d" .env)
    # A non-root caller can only see its own user's agents.
    ( load "$n"; [[ $EUID -eq 0 || $(id -un) == "$RUN_AS" ]] && print_tasks ) || true
  done
}

# End one task session. Kills exactly that tmux session (never pkill), then removes its worktree if
# clean (the branch stays). Called by cmd_stop with $SESSION/$TASK_ID set.
stop_task() {
  local keep=0
  [[ ${1:-} == --keep-worktree ]] && keep=1
  local wt common
  wt=${TASK_WORKTREES:-$DIR/worktrees}/$SESSION
  if running; then
    local ev_title ev_fix
    ev_title=$(tmx show-options -t "=$SESSION:" -qv @task_title 2>/dev/null || true)
    ev_fix=$(tmx show-options -t "=$SESSION:" -qv @task_fix 2>/dev/null || true)
    tmx kill-session -t "=$SESSION"
    ev_log stop "$NAME" "$TASK_ID" "$([[ $ev_fix == 1 ]] && echo fix || echo task)" "$ev_title"
    as_user rm -f "/tmp/tmux-$(id -u "$RUN_AS")/$SOCK"  # tmux can leave the socket behind
    echo "stopped $SESSION"
  else
    echo "$SESSION is not running"
  fi
  [[ $keep -eq 0 && -e $wt/.git ]] || return 0
  # The worktree knows its repo; no state to keep elsewhere.
  common=$(as_user git -C "$wt" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  sleep 1
  # No --force: git refuses if there are uncommitted or untracked changes.
  if as_user git -C "$common" worktree remove "$wt" 2>/dev/null; then
    echo "removed clean worktree $wt (branch kept)"
  else
    echo "kept worktree $wt (has changes); remove later with: git -C $common worktree remove $wt" >&2
  fi
}

case ${1:-} in
  start|stop|run|peek|task|tasks|resume) c=$1; shift; "cmd_$c" "$@" ;;
  task-run) shift; cmd_task_run "$@" ;;
  say) shift; cmd_say "$@" ;;
  deliver) cmd_deliver ;;
  list) cmd_list ;;
  *) sed -n '2,/^# Each agent/{/^# Each agent/!p}' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
