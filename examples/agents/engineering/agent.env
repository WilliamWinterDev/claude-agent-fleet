# Root-owned; installed to /etc/claude-agents/engineering.env.
RC_NAME=Engineering
RUN_AS=root
PERMISSION_MODE=auto
TASK_REPO=/opt/repos/infra
TASK_MODEL=sonnet
TASK_MAX=3
# task-settings.json denies these for the master and normal tasks; only a fix session may run them.
GUARDED="the end-to-end suite (scripts/e2e.sh)"
