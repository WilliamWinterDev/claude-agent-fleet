# Root-owned; installed to /etc/claude-agents/reviewer.env.
# Unprivileged user: it reads untrusted input (PR diffs from anyone), so it never runs as root.
RC_NAME=Reviewer
RUN_AS=agent-reviewer
PERMISSION_MODE=bypassPermissions
MODEL=opus
TASK_MODEL=sonnet
TASK_MAX=2
# Turn off the claude.ai connectors that come with the account login.
ENV_VARS="ENABLE_CLAUDEAI_MCP_SERVERS=false"
