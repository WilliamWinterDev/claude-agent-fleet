# /etc/claude-bridge/secrets.env (0640 root:claude-bridge). Never commit the real file.
# install.sh creates it with a random bearer token. Re-read on every request: edits need no restart.
BRIDGE_BEARER_TOKEN=REPLACE_ME
# Optional webhook back to the client (https only). Leave REPLACE_ME to send nothing.
BRIDGE_WEBHOOK_URL=REPLACE_ME
BRIDGE_WEBHOOK_KEY=REPLACE_ME
