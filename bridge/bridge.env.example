# /etc/claude-bridge/bridge.env (0644, no secrets here; they go in secrets.env)
# One address, never 0.0.0.0/:: (refused). Loopback when cloudflared runs on this host, or the
# host's tailnet address for the tailnet-only option.
BRIDGE_BIND=127.0.0.1:8793
# cloudflare-access: Access JWT AND bearer token required (public exposure through a Cloudflare Tunnel).
# bearer-only: bearer token only; for a private network such as a tailnet, never a public route.
BRIDGE_AUTH=cloudflare-access
# Access team domain (<team>.cloudflareaccess.com) and the Access application's AUD tag.
# Unset with BRIDGE_AUTH=cloudflare-access = every request is refused (fail closed).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
